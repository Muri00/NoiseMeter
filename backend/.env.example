# Копирайте този файл като .env и попълнете стойностите.

# Връзка с MariaDB (драйвер PyMySQL)
DATABASE_URL=mysql+pymysql://noisemeter:CHANGE_ME@localhost:3306/NoiseMeterDB?charset=utf8mb4

# Парола на root за MariaDB контейнера (docker-compose.yml)
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Таен ключ за подписване на JWT токените. Генерирайте с:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720

# Източник на звук: "device" (USB микрофон) или "simulator" (тестов сигнал без микрофон)
AUDIO_SOURCE=device
# Име или индекс на входното устройство в sounddevice (празно = по подразбиране)
AUDIO_DEVICE=
SAMPLE_RATE=48000
